# ─── SMTP / Email ────────────────────────────────────────────────
# Gmail with an App Password (16 chars). Spaces are auto-stripped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=

# Where owner notifications are delivered.
# NOTE: if OWNER_EMAIL == SMTP_USER on Gmail, the copy is hidden from your
# Inbox (it lands in All Mail). Use a DIFFERENT address here.
OWNER_EMAIL=orders@oryvexresearch.com
BUSINESS_EMAIL=support@oryvexresearch.com
OWNER_PHONE=+1 (645) 217-0576
WHATSAPP=+14795895269
DIRECT_PHONE=+16452170576
BUSINESS_NAME=Oryvex Research

# ─── Admin panel (HTTP Basic Auth) ───────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./oryvex.db

# ─── Ordering & shipping ─────────────────────────────────────────
MIN_ORDER=0                   # 0 = no minimum
FREE_SHIP_THRESHOLD=250       # free shipping at/above this
SHIP_PRIORITY=15              # Priority shipping price (< threshold)
SHIP_OVERNIGHT=45             # Overnight shipping price (< threshold)
INSURANCE_FEE=12              # optional shipping-insurance add-on

# ─── Accepted payment methods (comma-separated; shown at checkout) ─
PAYMENT_METHODS=Cash App,Zelle,Apple Pay,Chime,PayPal,Bitcoin
