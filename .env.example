# ─── SMTP / Email ────────────────────────────────────────────────
# Gmail with an App Password (16 chars). Spaces are auto-stripped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=

# Where owner notifications are delivered.
# NOTE: if OWNER_EMAIL == SMTP_USER on Gmail, the copy is hidden from your
# Inbox (it lands in All Mail). Use a DIFFERENT address here.
OWNER_EMAIL=orders@oryvexresearch.com
BUSINESS_EMAIL=support@oryvexresearch.com
OWNER_PHONE=+1 (645) 217-0576
WHATSAPP=+14795895269
DIRECT_PHONE=+16452170576
BUSINESS_NAME=Oryvex Research
# Shown in the header/footer. BUSINESS_ADDRESS is optional — leave blank
# until you have a real street address or PO Box.
BUSINESS_LOCATION=Perth, Western Australia
BUSINESS_ADDRESS=

# ─── Admin panel (HTTP Basic Auth) ───────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./oryvex.db

# ─── Ordering & shipping ─────────────────────────────────────────
# NOTE: no inline "# comment" after a value. systemd's EnvironmentFile does not
# strip them (only a # at the START of a line is a comment), so the app would
# receive e.g. "0   # no minimum" as the value. Comments go on their own line.

# 0 = no minimum order
MIN_ORDER=0
# free shipping at or above this subtotal
FREE_SHIP_THRESHOLD=350
# Standard Tracked (Australia Post) price in AUD, below the free-shipping threshold
SHIP_PRIORITY=15
# Express Post price in AUD, below the free-shipping threshold
SHIP_OVERNIGHT=25
# optional shipping-insurance add-on
INSURANCE_FEE=15

# ─── Accepted payment methods (comma-separated; shown at checkout) ─
PAYMENT_METHODS=Bank Transfer,Osko,PayID,Bitcoin
